# Copiez ce fichier en .env pour le développement local (jamais commité).
# En production (Render/Railway), définissez ces variables dans le dashboard
# du service, pas dans un fichier .env commité dans le dépôt Git.

SECRET_KEY=remplacez_par_une_valeur_aleatoire_longue_et_unique
FLASK_DEBUG=0
STRIPE_PAYMENT_LINK=https://buy.stripe.com/votre-lien-reel
DB_PATH=app.db

# Envoi d'email de confirmation (optionnel — sans ça, le lien de
# confirmation est juste écrit dans les logs du serveur).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-adresse@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_application_gmail
SMTP_FROM=votre-adresse@gmail.com
